# Copy to .env and fill in:  cp .env.example .env
#
# THIS FILE IS FOR SECRETS AND MACHINE-SPECIFIC OVERRIDES ONLY.
#
# Precedence (highest first):
#   environment  >  .env (this file)  >  config.yaml  >  code defaults
#
# Because .env outranks config.yaml, anything you set here SHADOWS the config
# file. Put tuning (chunk sizes, top-k, provider and reranker selection) in
# config.yaml where it is reviewable and version-controlled -- if you duplicate
# those keys here, editing config.yaml will appear to do nothing, which is a
# genuinely confusing afternoon.
#
# Uncomment a knob below only when you need to override the profile on ONE
# machine or ONE deployment.

# --- Secrets ---------------------------------------------------------------
# Which of these you need depends on the providers your config profile selects.
# Settings validates this at startup and names the missing one.

# Required when llm_provider: groq  (the default profile).
GROQ_API_KEY=gsk-replace-me

# Required when llm_provider: openai, OR embedding_provider: openai.
# Not needed at all for the default groq + sentence-transformers profile.
# OPENAI_API_KEY=sk-replace-me

# Required only when reranker: cohere.
# COHERE_API_KEY=

# --- Machine-specific overrides (optional) ---------------------------------
# Select a config profile. Defaults to config.yaml.
# CONFIG_FILE=config.local.yaml

# Run against an embedded ./chroma_db instead of the Chroma server. Handy
# outside Docker; docker-compose sets these for you.
# CHROMA_MODE=persistent
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION=documents

# Cache: `memory` avoids needing Redis at all for local work.
# CACHE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Serving. >1 worker REQUIRES PROMETHEUS_MULTIPROC_DIR or /metrics reports
# whichever worker happened to answer the scrape.
# UVICORN_WORKERS=2
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Startup behaviour (see scripts/start.sh).
# SKIP_INGESTION=true      # do not ingest ./data on boot
# INGEST_STRICT=true       # refuse to start if ingestion fails

# Quick overrides without editing the profile.
# LOG_LEVEL=DEBUG
# RERANKER=none               # cross-encoder | cohere | none
# EMBEDDING_PROVIDER=openai   # openai | sentence-transformers
# LLM_PROVIDER=openai         # openai | groq
# GROQ_MODEL=qwen/qwen3.8-27b # leaner, non-reasoning; fewer tokens per answer
